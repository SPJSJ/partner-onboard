# Leave both unset for local dev — the app falls back to a local SQLite file
# at server/data/partners.db.
#
# To point at a hosted Turso database instead (required for Vercel, since
# serverless functions have no persistent local disk), create a database at
# https://turso.tech, then fill these in from `turso db show <name>` and
# `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
